# Auto detect text files and perform LF normalization
* text=auto

# The build script copies branding images into the Codex package and CI compares
# them by SHA256. `* text=auto` already leaves PNGs alone, but pinning them makes
# root/package parity immune to a future attribute change rather than dependent
# on content sniffing.
*.png -text

# Keep copied original fonts byte-stable in both plugin surfaces.
*.woff2 -text

# Supplied crest SVGs have published SHA-256 metadata. Preserve their bytes
# through Windows checkouts and marketplace installs, including line endings.
skills/shaughv-design/assets/crests/*.svg -text
plugins/shaughv-code/skills/shaughv-design/assets/crests/*.svg -text
