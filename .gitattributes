# Auto detect text files and perform LF normalization
* text=auto

# build-codex-plugin.ps1 copies the root .mcp.json into the Codex package verbatim
# and CI compares the result by SHA256. Pinning every .mcp.json to LF on checkout
# (any platform) keeps the root file and its packaged copy byte-identical no matter
# what `* text=auto` + core.eol=native would otherwise do on a Windows runner, so
# the tracked package stays byte-reproducible. Pin any new *generated* package file
# the same way.
.mcp.json text eol=lf
